# ShwaasShala Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Model Provider for Strands Agent
# Options: bedrock | anthropic | openai | ollama | none
# Defaults to rule-based fallback if no credentials are configured
MODEL_PROVIDER=bedrock

# AWS Bedrock Configuration (Default / Recommended for Hackathon)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# OpenAI Configuration (Optional)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Anthropic Configuration (Optional)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# Ollama Configuration (Optional Local LLM)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2
